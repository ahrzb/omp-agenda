[68.063109, "o", "\u001b[?25l\u001b[?2026h\u001b[?7l\u001b[28;1H\u001b[0m\u001b[K\u001b[48;2;15;18;22;39m \u001b[38;2;229;88;196m⠦ 3s\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;229;88;196m◔ Sonnet 4.6\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;232;236;244m🗑 omp-agenda-demo\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;212;192;144mS0.11\u001b[39m \u001b[0;38;2;15;18;22m▶\u001b[0;49;38;2;229;88;196m─1%\u001b[38;2;42;48;56m────────────────────────────────────────────\u001b[38;2;156;163;176m╎\u001b[38;2;172;98;154m┃\u001b[38;2;42;48;56m────────\u001b[38;2;172;98;154m1M\u001b[38;2;42;48;56m─\u001b[39m\u001b[0m\r\u001b[29;4H\u001b[?25h\u001b[?7h\u001b[?2026l"]
