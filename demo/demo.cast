1b[38;2;107;114;128m6\u001b[39m \u001b[1mEviction policy & memory limits\u001b[22m                                                                       \u001b[0m\u001b[0m\r\u001b[11;1H\u001b[0m\u001b[K\u001b[0m  \u001b[38;2;107;114;128m \u001b[39m \u001b[38;2;156;163;176m○\u001b[39m \u001b[38;2;107;114;128m7\u001b[39m \u001b[1mCache warming & cold-start behavior\u001b[22m                                                                   \u001b[0m\u001b[0m\r\u001b[12;1H\u001b[0m\u001b[K\u001b[0m  \u001b[38;2;107;114;128m \u001b[39m \u001b[38;2;156;163;176m○\u001b[39m \u001b[38;2;107;114;128m8\u001b[39m \u001b[1mObservability (hit/miss metrics, alerting)\u001b[22m                                                            \u001b[0m\u001b[0m\r\u001b[32;1H\u001b[0m\u001b[K\u001b[0m \u001b[38;2;107;114;128mtab fold · S-tab overview · ↑↓/np heading · f/b sibling · u up · space/pgup page · d decisions · q close · a\u001b[0m…\u001b[0m\u001b[0m\r\u001b[?25l\u001b[1;1H\u001b[?7h\u001b[?2026l"]
[89.286169, "o", "\u001b[?25l\u001b[?2026h\u001b[?7l\u001b[1;1H\u001b]133;A\u0007\u001b[48;2;15;18;22m                                                                                                              \u001b[49m\u001b[0m\r\u001b[2;1H\u001b[48;2;15;18;22m \u001b[38;2;229;229;231mAgreed with your suggestion. Next.\u001b[39m                                                                           \u001b[49m\u001b[0m\r\u001b[3;1H\u001b[48;2;15;18;22m                                                                                                              \u001b[49m\u001b]133;B\u0007\u001b]133;C\u0007\u001b]133;D;0\u0007\u001b[0m\r\u001b[4;1H\u001b[0m\u001b[K\r\u001b[5;1H\u001b[0m\u001b[K\u001b[39;1magenda\u001b[22;39m \u001b[38;2;156;163;176mupdate 2 decided → Cache-aside — app owns cache logic, pairs with invalidate-on-write\u001b[38;2;107;114;128m, \u001b[39mfocus 3\u001b[39m         \u001b[0m\r\u001b[6;1H\u001b[0m\u001b[K\r\u001b[7;1H\u001b[0m\u001b[K \u001b[1m[3] Invalidation — you said invalidate-on-write. Let's pressure-test it.\u001b[22m                                     \u001b[0m\r\u001b[8;1H                                                                                                              \u001b[0m\r\u001b[9;1H Two sub-questions:                                                                                           \u001b[0m\r\u001b[10;1H                                                                                                              \u001b[0m\r\u001b[11;1H \u001b[38;2;0;180;255m1. \u001b[39;1mScope:\u001b[22m Do writes invalidate exact keys (e.g. \u001b[38;2;0;255;136mproduct:42\u001b[39m) or tag-based sets (e.g. everything under         \u001b[0m\r\u001b[12;1H    \u001b[38;2;0;255;136mcategory:electronics\u001b[39m)?                                                                                    \u001b[0m\r\u001b[13;1H \u001b[38;2;0;180;255m2. \u001b[39;1mFallback TTL:\u001b[22m Do you also set a TTL as a safety net in case a write is missed (bug, race, direct DB       \u001b[0m\r\u001b[14;1H    patch)?                                                                                                   \u001b[0m\r\u001b[15;1H                                                                                                              \u001b[0m\r\u001b[16;1H \u001b[1mMy lean:\u001b[22m Exact-key invalidation + a long TTL safety net (e.g. 24h). Tag/pattern invalidation (\u001b[38;2;0;255;136mSCAN\u001b[39m + \u001b[38;2;0;255;136mDEL\u001b[39m) is \u001b[0m\r\u001b[17;1H expensive at scale and error-prone. A background TTL means a missed invalidation is bounded in damage, not   \u001b[0m\r\u001b[18;1H permanent staleness.                                                                                         \u001b[0m\r\u001b[19;1H                                                                                                              \u001b[0m\r\u001b[20;1H\u001b[0m\u001b[K How granular are your write patterns — single-entity mutations only, or do you have bulk updates or          \u001b[0m\r\u001b[21;1H cross-entity side effects?                                                                                   \u001b[0m\r\u001b[22;1H\u001b[0m\u001b[K\r\u001b[23;1H                                                                        \u001b[2;3mCaching layer design interview session\u001b[23;22m\u001b[0m\r\u001b[24;1H\u001b[0m\u001b[K\r\u001b[25;1H\u001b[0m\u001b[K\u001b[48;2;15;18;22;38;2;0;180;255m▌\u001b[39m \u001b[48;2;0;130;179;38;2;0;180;255;1m Agenda \u001b[22;39;49;48;2;15;18;22m \u001b[48;2;0;130;179m \u001b[38;2;156;163;176m○\u001b[39;38;2;0;180;255;1m3\u001b[22;39m \u001b[49;48;2;15;18;22m \u001b[38;2;156;163;176m○\u001b[39;38;2;107;114;128m4\u001b[39m \u001b[38;2;156;163;176m○\u001b[39;38;2;107;114;128m5\u001b[39m \u001b[38;2;156;163;176m○\u001b[39;38;2;107;114;128m6\u001b[39m \u001b[38;2;156;163;176m○\u001b[39;38;2;107;114;128m7\u001b[39m \u001b[38;2;156;163;176m○\u001b[39;38;2;107;114;128m8\u001b[39m  \u001b[38;2;0;180;255mInvalidation strategy (TTL, event-driven, manual)\u001b[39m               \u001b[38;2;107;114;128m2/8 · alt+g ▾\u001b[39m \u001b[49m\u001b[0m\r\u001b[26;1H\u001b[0m\u001b[K\u001b[48;2;15;18;22;39m \u001b[38;2;107;114;128mπ\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;229;88;196m◔ Sonnet 4.6\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;232;236;244m🗑 omp-agenda-demo\u001b[39m \u001b[38;2;42;48;56m>\u001b[39m \u001b[38;2;212;192;144mS0.12\u001b[39m \u001b[0;38;2;15;18;22m▶\u001b[0;49;38;2;229;88;196m─1%\u001b[38;2;42;48;56m──────────────────────────────────────────────\u001b[38;2;156;163;176m╎\u001b[38;2;42;48;56m─\u001b[38;2;172;98;154m┃\u001b[38;2;42;48;56m────────\u001b[38;2;172;98;154m1M\u001b[38;2;42;48;56m─"]
